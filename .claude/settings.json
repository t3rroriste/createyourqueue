{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/upload_sftp.py\"",
            "timeout": 60,
            "statusMessage": "Envoi sur AdKyNet…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/sync_git.py\"",
            "timeout": 120,
            "statusMessage": "Enregistrement sur GitHub…"
          }
        ]
      }
    ]
  }
}
