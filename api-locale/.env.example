# Copiez ce fichier en « .env » et remplissez-le.
# Le vrai .env ne doit JAMAIS être partagé ni mis en ligne : il contient le secret.

# Portail développeur Discord -> votre application -> General Information
DISCORD_CLIENT_ID=

# Portail développeur Discord -> votre application -> OAuth2 -> Client Secret
# Celui-ci est un vrai secret. Il ne sort jamais du serveur, et n'a rien
# à faire dans config.js ni dans aucun fichier du site.
DISCORD_CLIENT_SECRET=

# Facultatif. Portail développeur Discord -> votre application -> Bot -> Token.
# Sans lui, la connexion marche, mais les listes de salons et de rôles du
# panneau restent vides : le jeton utilisateur n'y donne pas accès.
DISCORD_BOT_TOKEN=

# Port local. Changez-le si 3000 est déjà pris.
PORT=3000

# Laissez vide en local. En ligne, mettez l'adresse publique exacte,
# par exemple https://cyq.exemple.com
PUBLIC_URL=

# Passez à « production » une fois en HTTPS : les cookies deviennent Secure.
ENV=development

# ---------------------------------------------------------------------------
# En ligne seulement : le site et l'API ne sont plus sur la meme origine.
#
# Le site est sur LWS (qui ne sert que des fichiers), l'API sur la machine du
# bot, sous api.cyqbot.eu. Laisse ces deux lignes vides en local : une seule
# origine, rien a declarer.
# ---------------------------------------------------------------------------

# Ou renvoyer le navigateur a la fin de la connexion. Sans elle, l'API
# renverrait sur elle-meme, ou le panneau n'existe pas.
# Exemple : https://dashboard.cyqbot.eu
APP_URL=

# Qui a le droit d'appeler l'API depuis une autre origine, separe par des
# virgules. Une origine absente de cette liste ne recoit aucun en-tete CORS,
# donc le navigateur jette la reponse. Jamais * : la norme l'interdit avec
# les cookies de session.
# Exemple : https://dashboard.cyqbot.eu,https://cyqbot.eu
ALLOWED_ORIGINS=

# Le dossier du site a servir. Vide = live/ du depot s'il est la, sinon
# l'ancien dossier a plat. En ligne, l'API n'a pas besoin de servir le site :
# LWS s'en charge.
SITE_DIR=

# ---------------------------------------------------------------------------
# L'API du bot : ouvrir une queue depuis le panneau.
#
# Ouvrir une queue n'est pas une ecriture de reglage, c'est une action qui
# vit dans le bot. Ce serveur se contente de lui relayer la demande. Sans
# BOT_API_BASE, le bouton du panneau reste ferme et le dit : rien n'est
# jamais invente cote site.
# ---------------------------------------------------------------------------

# Racine de l'API que le bot ouvre deja pour ce panneau
# (cogs/dashboard_api.py), soit DASHBOARD_API_HOST:DASHBOARD_API_PORT.
# Exemple : http://127.0.0.1:8080
BOT_API_BASE=

# La DASHBOARD_API_KEY du bot, recopiee a l'identique. Elle part en
# en-tete X-API-Key. C'est un vrai secret : elle autorise a ouvrir des
# queues sur n'importe quel serveur, et elle n'a rien a faire dans
# config.js ni dans aucun fichier du site.
BOT_API_KEY=

# Secondes avant d'abandonner l'appel au bot. Au-dela, le panneau dit que
# rien n'a ete ouvert.
BOT_API_TIMEOUT=10
