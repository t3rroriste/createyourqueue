# Copie ce fichier en ".env" et remplis les valeurs.
# Ne JAMAIS partager ce fichier ni le committer sur GitHub.
# Pour trouver un ID : active le mode développeur dans les paramètres Discord,
# puis clic droit sur le serveur, le salon ou le membre > Copier l'identifiant.

# Token du bot principal (obtenu sur discord.com/developers)
DISCORD_TOKEN=colle_ton_token_ici

# Token du bot temporaire (facultatif, commandes /waiting et /tempo)
DISCORD_TOKEN_TEMPORAIRE=

# Token du bot modmail (facultatif, support par message privé)
DISCORD_TOKEN_MODMAIL=

# Ton identifiant Discord : seul lui peut utiliser /waiting et /tempo.
# 0 = le propriétaire de l'application Discord.
OWNER_ID=0

# ID de ton serveur officiel : il saute l'assistant de configuration et
# reste toujours en français. 0 si tu n'en as pas.
SUPPORT_GUILD_ID=0

# Invitation de ton serveur d'aide : lien de /support et bouton du message
# d'arrivée du bot. Vide = le serveur de support officiel CYQ.
SUPPORT_INVITE=

# Bot modmail : serveur de support, salon staff privé où arrivent les tickets,
# et rôle autorisé à les gérer (0 = quiconque voit le salon staff).
MODMAIL_GUILD_ID=0
MODMAIL_STAFF_CHANNEL_ID=0
MODMAIL_STAFF_ROLE_ID=0

# Salon qui reçoit les messages de démarrage des bots (0 = désactivé)
DIAGNOSTIC_CHANNEL_ID=0

# API lue par le site web (dashboard). Vide = le bot n'ouvre aucun port.
# Mets ici une longue clé au hasard, la même que dans le .env du site.
#
# LE PORT NE SE DEVINE PAS, et sur un hébergeur il ne se choisit pas non
# plus : chez AdKyNet (Pterodactyl), seule l'allocation du serveur est
# redirigée depuis l'extérieur. Le bot la lit donc tout seul dans
# SERVER_PORT, que l'hébergeur pose, et la ligne ci-dessous n'est alors
# même pas regardée — c'est voulu : le 8080 du modèle, recopié tel quel le
# 2 novembre 2026, est le port du démon de l'hébergeur et n'a jamais été
# une allocation. Le bot écoutait, et personne ne pouvait l'appeler.
#
# DASHBOARD_API_PORT ne sert donc qu'ailleurs : une machine ordinaire, ou
# ce PC. Le port effectif est écrit au démarrage dans la console.
DASHBOARD_API_KEY=
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8080
