# Copie ce fichier en ".env" sur le VPS du site et remplis les valeurs.
# Ne JAMAIS partager ce fichier ni le committer sur GitHub.

# --- Ton application Discord (discord.com/developers/applications) ---
# Onglet OAuth2 : l'identifiant public et le secret client.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Adresse de retour après connexion Discord. Elle doit être ajoutée
# MOT POUR MOT dans OAuth2 > Redirects, côté Discord.
DISCORD_REDIRECT_URI=https://ton-domaine.fr/callback

# --- Sessions ---
# Longue chaîne au hasard, elle signe le cookie de connexion.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Lien vers le bot ---
# Adresse de l'API ouverte par le bot sur l'autre serveur (cogs/dashboard_api.py),
# et la clé DASHBOARD_API_KEY du .env du bot, identique des deux côtés.
BOT_API_URL=http://ip-du-serveur-du-bot:8080
BOT_API_KEY=

# --- Bouton « Inviter le bot » ---
# Permissions demandées à l'invitation. 8 = administrateur, le plus simple
# pour que tout marche (salons de match, clans, modération, anti-raid).
BOT_INVITE_PERMISSIONS=8
