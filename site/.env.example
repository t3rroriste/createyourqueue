# Copie ce fichier en ".env" et remplis les valeurs.
# Ne JAMAIS partager ce fichier ni le committer sur GitHub.
# Ce .env est celui du SITE. Le bot a le sien, a la racine du projet.

# --- Application Discord (discord.com/developers) --------------------
# Onglet OAuth2. Le client secret se regenere la, si tu l'as perdu.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL de retour apres connexion. Elle doit etre ajoutee a l'identique
# dans OAuth2 > Redirects, sinon Discord refuse la connexion.
OAUTH_REDIRECT_URI=https://ton-domaine.fr/callback

# --- API du bot (voir cogs/dashboard_api.py) --------------------------
# L'adresse ou le bot ecoute, et la MEME cle que DASHBOARD_API_KEY dans
# le .env du bot. Sans elles, le site demarre mais ne peut rien lire.
BOT_API_URL=http://ip-du-bot:8080
BOT_API_KEY=

# Secondes avant d'abandonner un appel au bot.
BOT_API_TIMEOUT=10

# --- Session ----------------------------------------------------------
# Une longue chaine au hasard, gardee secrete. La changer deconnecte
# tout le monde. Pour en generer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Duree d'une connexion, en secondes (7 jours par defaut).
SESSION_MAX_AGE=604800

# Cookie envoye en HTTPS seulement. Mets 0 pour tester en local sans
# certificat, jamais en production.
SESSION_HTTPS_ONLY=1

# --- Serveur web ------------------------------------------------------
# Laisse 127.0.0.1 si nginx est devant (recommande, voir README.md).
SITE_HOST=127.0.0.1
SITE_PORT=8000

# --- Affichage --------------------------------------------------------
# Permissions demandees par le bouton « Inviter le bot ».
INVITE_PERMISSIONS=1099780063312

# Lien du serveur d'aide, affiche en pied de page. Vide = pas de lien.
SUPPORT_INVITE=
