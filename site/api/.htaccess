# Tout ce qui arrive sous /api/ est traité par index.php.
#
# `!-f` laisse passer un fichier qui existe vraiment : sans cette condition,
# index.php se rappellerait lui-même en boucle.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Une réponse d'API dépend de la session : elle ne se met jamais en cache.
# La règle du .htaccess parent garde le CSS et le JS un an ; sans celle-ci,
# un cache pourrait resservir la réponse d'une personne à une autre.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate"
</IfModule>

# Le fichier des secrets n'est jamais servi, même si PHP était désactivé —
# auquel cas son contenu partirait en clair.
#
# TOUT CE QUI COMMENCE PAR « secrets », et pas seulement le nom exact : la
# règle ne couvrait que « secrets.php », si bien qu'une copie déposée à
# côté — secrets.sauvegarde.php, secrets.old.php, le genre de filet qu'on
# pose avant de modifier — n'aurait été protégée par rien. C'est le jour
# où PHP s'arrête que ça se paye, et ce jour-là on ne le choisit pas.
<FilesMatch "^secrets.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
